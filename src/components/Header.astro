---
import { SITE_NAME, BLOG_TITLE } from '../consts';

const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <nav>
      <span class="brand"><a href="/">{SITE_NAME}</a></span>
      <a href="/blog/" aria-current={here.startsWith('/blog') ? 'page' : undefined}>
        {BLOG_TITLE}
      </a>
    </nav>
  </div>
</header>
