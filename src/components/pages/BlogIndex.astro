---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../PostList.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (
  await getCollection('blog', ({ data }) => data.lang === lang && !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout lang={lang} title={t('blog.title')} description={t('blog.description')}>
  <h1>{t('blog.title')}</h1>
  <p class="tagline">{t('blog.description')}</p>

  {posts.length === 0 ? <p class="muted">{t('blog.empty')}</p> : <PostList posts={posts} lang={lang} />}
</BaseLayout>
