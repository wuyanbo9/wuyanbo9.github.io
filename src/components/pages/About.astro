---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('about.title')} description={t('about.description')}>
  <h1>{t('about.title')}</h1>
  <p>{t('about.p1')}</p>
  <p>{t('about.p2')}</p>
  <p>{t('about.p3')}</p>
</BaseLayout>
