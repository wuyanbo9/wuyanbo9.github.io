---
import { SITE_COPYRIGHT } from '../consts';
import { UI, type Lang } from '../i18n';
import { musicHome } from '../music/lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer wrap">
  <span>© {year} {SITE_COPYRIGHT}</span>
  <a class="music-link" href={musicHome()}>{UI[lang].musicTitle}</a>
</footer>
