---
import MusicLayout from '../../../layouts/MusicLayout.astro';
import Note from '../../../music/components/Note.astro';
import TrackIndex from '../../../music/components/TrackIndex.astro';
import { issues } from '../../../music/lib/content';
import { formatDate, formatIssueLabel } from '../../../music/lib/format';
import { markdown } from '../../../music/lib/markdown';
import { issueUrl, issuesUrl } from '../../../music/lib/paths';
import type { Issue } from '../../../music/lib/types';

export function getStaticPaths() {
  return issues.map((issue) => ({
    params: { slug: issue.slug },
    props: { issue },
  }));
}

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const index = issues.findIndex((item) => item.slug === issue.slug);
const newer = index > 0 ? issues[index - 1] : null;
const older = index >= 0 && index < issues.length - 1 ? issues[index + 1] : null;

const meta = [
  formatDate(issue.publishedAt),
  formatIssueLabel(issue.number),
  issue.label,
  `${issue.tracks.length} 首`,
]
  .filter(Boolean)
  .join(' · ');
---

<MusicLayout title={issue.title} description={issue.summary} type="article">
  <a class="backlink" href={issuesUrl()}>← 往期</a>

  <header class="issue-head">
    <p class="kicker">{meta}</p>
    <h1>{issue.title}</h1>
    <div class="prose issue-intro" set:html={markdown(issue.intro)} />
  </header>

  <section class="contents" aria-labelledby="contents-title">
    <h2 id="contents-title" class="section-label">本期曲目</h2>
    <TrackIndex tracks={issue.tracks} />
  </section>

  {issue.tracks.map((track, trackIndex) => (
    <Note track={track} index={trackIndex} />
  ))}

  <footer class="issue-footer">
    {older ? (
      <a class="other-issue" href={issueUrl(older.slug)}>
        ← 较早一期
        <span>{formatIssueLabel(older.number)} · {older.title}</span>
      </a>
    ) : (
      <span></span>
    )}
    {newer ? (
      <a class="other-issue" href={issueUrl(newer.slug)}>
        较新一期 →
        <span>{formatIssueLabel(newer.number)} · {newer.title}</span>
      </a>
    ) : (
      <a href={issuesUrl()}>全部期数 →</a>
    )}
  </footer>
</MusicLayout>
