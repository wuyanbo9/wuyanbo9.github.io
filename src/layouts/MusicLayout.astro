---
import BaseLayout from './BaseLayout.astro';
import { site } from '../music/lib/content';
import '../styles/music.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

// The weekly is written in Chinese throughout, so its pages are always zh,
// and it has no feed of its own.
const { title, description = site.description, type = 'website' } = Astro.props;
---

<BaseLayout
  lang="zh"
  title={title}
  description={description}
  type={type}
  siteName={site.name}
  feed={false}
>
  <slot />
</BaseLayout>
